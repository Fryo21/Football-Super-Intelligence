
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FSI Canonical Tracking Frame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "match_id",
    "source",
    "match_second",
    "tick",
    "ball_position",
    "ball_owner_id",
    "player_positions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "frame_id": {
      "type": "string",
      "minLength": 1
    },
    "match_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "const": "footysim"
    },
    "match_second": {
      "type": "number",
      "minimum": 0
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "ball_position": {
      "$ref": "#/$defs/position"
    },
    "ball_owner_id": {
      "type": ["string", "null"]
    },
    "player_positions": {
      "type": "object",
      "minProperties": 22,
      "maxProperties": 22,
      "additionalProperties": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
